{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/index.ts": { "maxDuration": 10 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/gateway/:path*", "destination": "/api" },
    { "source": "/((?!api|gateway).*)", "destination": "/index.html" }
  ]
}
